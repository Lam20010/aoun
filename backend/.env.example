# Copy to .env for local runs. Never commit real values.
AOUN_TOOL_KEY=            # long random string; the same value goes into the ElevenLabs secret "aoun_tool_key"
AOUN_ADMIN_KEY=           # different long random string for staff/admin routes
AOUN_WEBHOOK_SECRET=      # from ElevenLabs post-call webhook settings (HMAC secret)
AOUN_PHONE_ENC_KEY=       # at least 32 random characters; encrypts phone numbers at rest
AOUN_DB_PATH=aoun.db
# Optional, only for real outbound phone calls:
ELEVENLABS_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=
