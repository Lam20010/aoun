{
  "expo": {
    "name": "عون",
    "slug": "aoun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aoun-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0F2E30",
    "splash": { "image": "./assets/aoun-icon.png", "resizeMode": "contain", "backgroundColor": "#0F2E30" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sa.aoun.demo",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "عون يستخدم المايك عشان تكلّمين رُفيدة بصوتك. ما يُحفظ صوتك.",
        "NSLocationWhenInUseUsageDescription": "عون يستخدم موقعك مرة وحدة عشان يرتّب لك أقرب مكان. ما تُحفظ إحداثياتك.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "sa.aoun.demo",
      "adaptiveIcon": { "backgroundColor": "#FFFFFF", "foregroundImage": "./assets/aoun-icon.png" },
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      ["expo-audio", { "microphonePermission": "عون يستخدم المايك عشان تكلّمين رُفيدة بصوتك. ما يُحفظ صوتك." }]
    ]
  }
}
