{
  "expo": {
    "name": "عون",
    "slug": "aoun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#002336",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#002336"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sa.aoun.demo",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "عون يستخدم المايك عشان تكلّمين رُفيدة بصوتك. ما يُحفظ صوتك.",
        "NSLocationWhenInUseUsageDescription": "عون يستخدم موقعك مرة وحدة عشان يرتّب لك أقرب مكان. ما تُحفظ إحداثياتك.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sa.aoun.demo",
      "adaptiveIcon": {
        "backgroundColor": "#002336",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BLUETOOTH_CONNECT",
        "INTERNET",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "عون يستخدم المايك عشان تكلّمين رُفيدة بصوتك. ما يُحفظ صوتك."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "عون يستخدم موقعك مرة وحدة عشان يرتّب لك أقرب مكان. ما تُحفظ إحداثياتك."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-notifications",
        {
          "color": "#2F7F80"
        }
      ],
      "expo-secure-store",
      "expo-dev-client"
    ],
    "scheme": "aoun",
    "newArchEnabled": true,
    "extra": {
      "apiBase": "https://aoun-voice-tools.onrender.com"
    }
  }
}
